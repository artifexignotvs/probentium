{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:probentium:schema:deadline-plan.v1",
  "title": "Explicit bounded operational deadline plan",
  "description": "Structural contract only. Runtime enforces previous-node references, unique node/input IDs, output as final node, no unreachable nodes, byte/step limits and reference scope. No legal applicability or review certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nodes",
    "output"
  ],
  "properties": {
    "schema": {
      "const": "probentium.deadline-plan.v1"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "op",
              "anchor"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "op": {
                "const": "anchor"
              },
              "anchor": {
                "enum": [
                  "awareness",
                  "classification",
                  "submitted",
                  "intermediate",
                  "latest_intermediate",
                  "measure_available",
                  "resolved"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "op",
              "input",
              "unit",
              "amount"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "op": {
                "const": "shift"
              },
              "input": {
                "$ref": "#/$defs/id"
              },
              "unit": {
                "enum": [
                  "hours",
                  "days",
                  "months"
                ]
              },
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 366
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "op",
              "input",
              "count",
              "include_start_day",
              "completion"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "op": {
                "const": "working_days"
              },
              "input": {
                "$ref": "#/$defs/id"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 366
              },
              "include_start_day": {
                "type": "boolean"
              },
              "completion": {
                "enum": [
                  "local_end_of_day",
                  "same_local_time"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "op",
              "input",
              "mode"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "op": {
                "const": "nonworking_adjust"
              },
              "input": {
                "$ref": "#/$defs/id"
              },
              "mode": {
                "enum": [
                  "none",
                  "next_working_day_end",
                  "dora_next_working_day_noon"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "op",
              "inputs",
              "mode"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "op": {
                "const": "combine"
              },
              "inputs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "mode": {
                "enum": [
                  "minimum",
                  "maximum"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "op",
              "candidates"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "op": {
                "const": "precedence"
              },
              "candidates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "applies"
                  ],
                  "properties": {
                    "input": {
                      "$ref": "#/$defs/id"
                    },
                    "applies": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "op",
              "awareness",
              "classification"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "op": {
                "const": "dora_initial"
              },
              "awareness": {
                "$ref": "#/$defs/id"
              },
              "classification": {
                "$ref": "#/$defs/id"
              }
            }
          }
        ]
      }
    },
    "output": {
      "$ref": "#/$defs/id"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    }
  }
}
